{
  "name": "dsh-wallpaper-engine",
  "version": "1.1.7",
  "description": "Puts a wallpaper behind DeepSeek Harness: the one Wallpaper Engine has active, one pinned from the Workshop library, or a picture dropped into a plain folder when Wallpaper Engine is not installed. Translucent panels, per-block blur, wallpaper-matched text contrast and a settings page with a live library picker.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "discovery.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-modules"
      ]
    }
  },
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "wallpaper",
    "wallpaper-engine",
    "theme",
    "skin",
    "steam"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SharpWord/dsh-wallpaper-engine.git"
  },
  "homepage": "https://github.com/SharpWord/dsh-wallpaper-engine#readme",
  "bugs": {
    "url": "https://github.com/SharpWord/dsh-wallpaper-engine/issues"
  },
  "author": "SharpWord",
  "license": "MIT"
}
